# Copy to .env.local and fill in. Never commit .env.local.
# ZOOWORK_API_KEY and TAVILY_API_KEY can also come from your system environment.
ZOOWORK_API_KEY=
TAVILY_API_KEY=
# Written for you by `npm run setup-agent`
ZOOWORK_AGENT_ID=
# Set to 1 to skip all live APIs and use mock results
MOCK_MODE=0
